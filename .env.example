DATABASE_URL="postgresql://postgres:123456@localhost:5433/carmetasearch"

# JWT Secret
JWT_SECRET="your-secret-key-change-in-production"

# Twilio SMS (using Verify API for OTP)
# Get these from: https://console.twilio.com/
# Account SID & Auth Token: Account -> API Credentials
# Verify Service SID: Verify -> Services -> Create Service (or use existing)
# Note: Verify API handles OTP generation and validation automatically
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email (optional, for future use)
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Optional: frontend origin for CORS (e.g. https://your-app.vercel.app). Defaults to http://localhost:3000.
# FRONTEND_ORIGIN=http://localhost:3000
