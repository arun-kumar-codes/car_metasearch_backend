generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Platform staff (SUPERADMIN, ADMIN) – separate from dealers; auth via email + password
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   // SUPERADMIN | ADMIN
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model Agency {
  id     String @id @default(uuid())

  phone                    String?  @unique
  password                 String?
  phoneVerified            Boolean   @default(false)
  phoneOtpToken            String?
  phoneOtpExpires          DateTime?
  loginOtpToken            String?
  loginOtpExpires          DateTime?
  
  email                    String?
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  lastLoginAt              DateTime?

  name                  String
  businessType          String?
  gstNumber             String? @unique
  panNumber             String?
  registrationNumber    String?
  yearOfEstablishment   Int?
  role                  String  @default("DEALER_ADMIN") // DEALER_ADMIN | DEALER_USER

  contactPersonName String?
  contactPhone      String?
  contactEmail      String?
  whatsappNumber    String?
  websiteUrl        String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?
  country      String? @default("India")
  serviceAreas Json?   // Array of cities/regions they serve

  bankName          String?
  accountNumber     String?
  ifscCode          String?
  accountHolderName String?

  apiUrl          String?
  apiKey          String?
  integrationType String  @default("API")
  apifyActorId    String?

  cpc             Float    @default(0.0)
  cpl             Float    @default(0.0)
  walletBalance   Float    @default(0) // Agency pays platform from this wallet
  isActive        Boolean  @default(false)
  onboardingStatus String  @default("PENDING")
  approvalStatus  String   @default("PENDING")
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  lastSyncedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  listings    Listing[]
  clicks      Click[]
  users       AgencyUser[]
  apiSources  AgencyApiSource[]
  agencyBills AgencyBill[]

  @@index([phone])
  @@index([email])
  @@index([gstNumber])
  @@index([onboardingStatus])
  @@index([approvalStatus])
  @@index([role])
}

// Multiple API feeds per agency (e.g. multiple affiliate feeds)
model AgencyApiSource {
  id       String  @id @default(uuid())
  agencyId String
  agency   Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  name    String?  // Optional label, e.g. "Cars24 feed", "Partner API"
  apiUrl  String
  apiKey  String?
  order   Int      @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
}

// Bill generated for an agency (CPL charges for a period); agency pays from wallet
model AgencyBill {
  id          String    @id @default(uuid())
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  periodLabel String    // e.g. "2025-03"
  amount      Float
  status      String    @default("PENDING") // PENDING | PAID
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([agencyId])
  @@index([status])
  @@index([periodLabel])
}

// Organisation users: login with email+password, see only their agency's data
model AgencyUser {
  id           String   @id @default(uuid())
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  role         String   @default("DEALER_USER") // DEALER_ADMIN | DEALER_USER
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agencyId])
  @@index([email])
}

model Listing {
  id       String  @id @default(uuid())
  agencyId String
  agency   Agency  @relation(fields: [agencyId], references: [id])

  brand    String
  model    String
  variant  String?
  year     Int
  mileage  Int
  price    Float
  currency String  @default("INR")

  color        String?
  fuelType     String?
  transmission String?
  bodyType     String?

  city    String?
  state   String?
  country String?

  isAvailable Boolean @default(true)
  externalUrl String?
  ownership   String?

  images      Json?   // Array of image URLs (string[])
  imageSource String? // 'S3' for manual uploads, 'EXTERNAL' for scraped data, null for API listings
  listingSource String? // 'MANUAL' | 'API' | 'APIFY' – which pipeline created this listing
  externalId  String? // Affiliate/API listing id for sync dedupe (API-sourced only)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clicks    Click[]

  @@index([brand, model, year])
  @@index([agencyId])
  @@index([isAvailable])
  @@index([city])
  @@index([agencyId, listingSource])
}

model Click {
  id        String  @id @default(uuid())
  listingId String?
  agencyId  String
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  agency    Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?
  referer   String?
  converted Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([agencyId])
  @@index([createdAt])
}

// Consumer user (car buyer) - mobile + OTP login
model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  email     String?
  suggestionsOptIn Boolean @default(false)
  welcomeWhatsAppSentAt DateTime? // set when first-login WATI welcome template is sent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history  UserListingView[]
  wishlist UserWishlist[]

  @@index([phone])
}

// Viewed cars history (by listing id)
model UserListingView {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String

  viewedAt  DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

// Wishlist (saved cars)
model UserWishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}
